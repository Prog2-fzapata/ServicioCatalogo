CATALOGO_DB_NAME=catalogo_db
CATALOGO_DB_USER=catalogo_user
CATALOGO_DB_PASSWORD=cambiar

POSTGRES_PORT=5432
CATALOGO_PORT=8081

SPRING_PROFILES_ACTIVE=dev

# Clave HMAC del JWT en Base64 (mínimo 512 bits): generar con `openssl rand -base64 64`.
# Turnos debe usar el mismo valor para validar los tokens.
JWT_SECRET=cambiar

# Cátedra: URL base de su API (sin "/" final) y JWT técnico (el id_token que devuelve su POST /api/authenticate).
# Los entrega la cátedra al registrar la cuenta técnica; el JWT dura un año. Son obligatorias: sin ellas el servicio no arranca.
CATEDRA_BASE_URL=cambiar
CATEDRA_JWT=cambiar

# Redis de la cátedra (solo lectura). Datos de la cuenta técnica ("integration"); como host va la IP de ZeroTier,
# porque el que devuelve la cátedra es interno. Son obligatorias: sin ellas el servicio no arranca.
CATEDRA_REDIS_HOST=cambiar
CATEDRA_REDIS_PORT=6379
CATEDRA_REDIS_USERNAME=cambiar
CATEDRA_REDIS_PASSWORD=cambiar

# Nombres del contrato de la cátedra: ruta del snapshot y claves de Redis. Traen los valores del contrato v1; si la
# cátedra cambia alguno, se edita acá y se reinicia el servicio, sin tocar el código. Son obligatorias.
CATEDRA_SNAPSHOT_PATH=/api/synchronization/snapshot
CATEDRA_REDIS_KEY_METADATA=catedra:sync:metadata
CATEDRA_REDIS_KEY_CHANGES_PREFIX=catedra:sync:changes:
CATEDRA_REDIS_KEY_CATEGORIES=catedra:sync:professional-categories
CATEDRA_REDIS_KEY_PROFESSIONALS=catedra:sync:professionals
CATEDRA_REDIS_KEY_WEEKLY_SCHEDULES=catedra:sync:weekly-schedules
